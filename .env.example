# 复制本文件为 .env 后填写；.env 不会被提交到仓库。

# ---- 病虫害识别：任意 OpenAI 兼容的视觉大模型 ----
# 默认示例为智谱 GLM-4.1V-Thinking-Flash（免费）：https://open.bigmodel.cn/ → API-KEY
# 只要接口兼容 OpenAI chat/completions，都可以换（千问 / 豆包 / 硅基流动 / 本地 Ollama）
# 注意：旧的 glm-4v-flash 不支持 base64 传图
VISION_API_KEY=
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 模型名留空时按端点自动选：智谱 → glm-4.1v-thinking-flash，其余 → qwen-vl-plus
# VISION_MODEL=glm-4.1v-thinking-flash
# 主模型限流（429/1305）时自动切换的备选模型，留空不切换
# VISION_FALLBACK_MODEL=glm-4.1v-flash

# 图片传参格式：data_uri（默认）| raw（个别网关要求纯 base64）
# VISION_IMAGE_FORMAT=data_uri
# VISION_TIMEOUT=45
# 二次确认：病虫害结论再问一次模型，答「没有该症状」则降级为无法判断；
# 设为 0 关闭（回到单次调用）；健康/无法判断类结果始终不触发复核。
# VISION_CONFIRM=1
# VISION_CONFIRM_TIMEOUT=12

# 识别渠道：auto（默认，有 Key 用真实 API）| api | custom | mock
VISION_PROVIDER=auto

# --- 可选：换回通义千问（旧变量名仍兼容）---
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# VISION_MODEL=qwen-vl-plus

# 可选：自定义视觉 API（约定 POST {image_base64, plot_id} → {class, confidence, bbox}）
# 与上面的云端 VISION_API_KEY 是两套配置，不要混用
# VISION_CUSTOM_URL=
# VISION_CUSTOM_KEY=

# ---- 一物一码 ----
# 设置后二维码内容为 {QR_BASE_URL}/trace?code=xxx，消费者可用微信扫码打开 H5；
# 留空则二维码内容就是溯源码本身，由小程序「扫一扫」解析。
QR_BASE_URL=

# ---- 天气联动（Open-Meteo，免 Key）----
# 未来 3 天连续降雨/高湿时，待办里会出现「霜疫霉病风险」提示。
# 设为 0 可关闭（断网或不想发外网请求时）；接口失败会自动静默跳过。
# 注意：下面的经纬度只是默认值；在 H5 / 小程序「天气地区」里保存过地区后，
# 以界面保存到 SQLite 的地区为准（保存后立即生效，重启不丢）。
WEATHER_ENABLED=1
WEATHER_LAT=23.55
WEATHER_LON=113.58
WEATHER_LOCATION=广东省广州市从化区
# WEATHER_TIMEOUT=3
