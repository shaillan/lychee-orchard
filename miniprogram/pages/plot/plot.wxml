<view class="wrap {{fontClass}}">
  <view wx:if="{{loading}}" class="card muted">加载中…</view>
  <view wx:elif="{{error}}" class="card error">
    <view>{{error}}</view>
    <view class="btn ghost small mt" bindtap="retry">重试</view>
  </view>

  <block wx:elif="{{plot}}">
    <view class="card">
      <view class="head">
        <text class="title">{{plot.name}}</text>
        <text class="pill {{plot.safe ? 'good' : 'critical'}}">{{plot.safe ? '可采收' : '间隔期内'}}</text>
      </view>
      <view class="kv"><text class="k">品种</text><text class="v">{{plot.variety}}</text></view>
      <view class="kv"><text class="k">面积 / 株数</text><text class="v">{{plot.area_mu}} 亩 · {{plot.tree_count}} 株</text></view>
      <view class="kv"><text class="k">定植年份</text><text class="v">{{plot.planting_year}}</text></view>
      <view class="kv"><text class="k">位置</text><text class="v">{{plot.location}}</text></view>
      <view wx:if="{{!plot.safe}}" class="alert critical mt">
        <view class="al-title">用药安全间隔期内</view>
        <view class="al-detail">{{plot.safety.message}}</view>
      </view>
    </view>

    <view wx:if="{{maturity}}" class="card">
      <view class="card-head">
        <text class="h2">采收窗口</text>
        <text class="pill {{maturity.statusClass}}">{{maturity.status}}</text>
      </view>
      <view class="kv"><text class="k">最佳采收期</text><text class="v">{{maturity.window_start}} ~ {{maturity.window_end}}</text></view>
      <view class="kv"><text class="k">当前物候期</text><text class="v">{{maturity.phenology}}</text></view>
      <view wx:if="{{maturity.status === '临近'}}" class="kv">
        <text class="k">距窗口开始</text><text class="v">{{maturity.days_to_start}} 天</text>
      </view>
      <view wx:elif="{{maturity.status === '最佳'}}" class="kv">
        <text class="k">窗口剩余</text><text class="v">{{maturity.days_remaining}} 天</text>
      </view>
      <view wx:elif="{{maturity.status === '已过'}}" class="kv">
        <text class="k">已过窗口</text><text class="v">{{maturity.days_overdue}} 天</text>
      </view>
      <view class="small muted mt">{{maturity.label}}</view>
      <view wx:if="{{lastCheck}}" class="maturity-check mt">
        <view class="small">最近观察：成熟度 {{lastCheck.ripeness}}% · {{lastCheck.date}} · {{lastCheck.operator}}</view>
        <view wx:if="{{lastCheck.note}}" class="small muted">{{lastCheck.note}}</view>
        <image wx:if="{{lastCheck.image_url}}" class="check-img" src="{{lastCheck.image_url}}" mode="aspectFill"></image>
      </view>
      <view wx:else class="small muted mt">暂无成熟度观察记录（规则判定不依赖拍照，照片仅作佐证）</view>
    </view>

    <view class="card">
      <view class="card-head">
        <text class="h2">产量趋势（kg）</text>
        <view class="legend">
          <view class="lg-dot lg-act"></view><text class="lg-txt">实际</text>
          <view class="lg-dot lg-est"></view><text class="lg-txt">预估</text>
        </view>
      </view>
      <view class="chart" wx:if="{{yields.length}}">
        <view wx:for="{{yields}}" wx:key="season" class="bar-col">
          <view class="bar-stack">
            <view wx:if="{{item.estH}}" class="bar bar-est" style="height: {{item.estH}}%"></view>
            <view wx:if="{{item.actH}}" class="bar bar-act" style="height: {{item.actH}}%"></view>
          </view>
          <text class="bar-season">{{item.season}}</text>
        </view>
      </view>
      <view wx:else class="empty">暂无产量记录</view>
    </view>

    <view class="card">
      <view class="h2">最近农事记录</view>
      <block wx:if="{{plot.operations.length}}">
        <view wx:for="{{plot.operations}}" wx:key="id" class="list-item">
          <view class="li-main">
            <view class="li-title">{{item.operation_type}}</view>
            <view class="li-desc">{{item.operator}} · {{item.operation_date}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">暂无记录</view>
    </view>

    <view class="card">
      <view class="h2">最近用药台账</view>
      <block wx:if="{{plot.pesticides.length}}">
        <view wx:for="{{plot.pesticides}}" wx:key="id" class="list-item">
          <view class="li-main">
            <view class="li-title">{{item.pesticide_name}}</view>
            <view class="li-desc">{{item.apply_time}} · 安全间隔期 {{item.safe_interval_days}} 天</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">暂无记录</view>
    </view>
  </block>
</view>
