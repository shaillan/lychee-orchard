.photo-box {
  background: #f7faf8;
  border: 2rpx dashed #cfe3d7;
  border-radius: 16rpx;
  height: 320rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo { width: 100%; height: 100%; }

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #6c7d72;
  font-size: 26rpx;
}
.photo-empty .cam { font-size: 64rpx; margin-bottom: 10rpx; }
.photo-empty .small { margin-top: 6rpx; }

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.head .title { font-size: 30rpx; font-weight: 600; }

.pre {
  white-space: pre-wrap;
  font-size: 26rpx;
  color: #2c3a31;
  line-height: 1.7;
  background: #f7faf8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.pills { line-height: 2.2; }
.pills .pill { margin: 0 10rpx 10rpx 0; }

/* 识别记录 */
.hist-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f0;
}
.hist-item:last-child { border-bottom: none; }
.hist-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.hist-title { font-size: 28rpx; font-weight: 600; }
.hist-meta { font-size: 23rpx; color: #7a8a80; margin-top: 4rpx; }

/* 知识库入口 */
.kb-entry { display: flex; align-items: center; }
.kb-entry-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.kb-entry .picker-arrow { flex: none; font-size: 32rpx; }
.font-lg .kb-entry .picker-arrow { font-size: 38rpx; }

/* 误判纠错面板 */
.correct-box {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #F5F9F5;
  border: 1rpx solid #E1EBE2;
}
.correct-box .picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE8DF;
  font-size: 27rpx;
}
.correct-box .picker-arrow { color: #9AA9A0; font-size: 30rpx; }
.font-lg .correct-box .picker-value { font-size: 32rpx; }
