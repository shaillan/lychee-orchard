<view class="wrap {{fontClass}}">
  <view class="card kb-entry" bindtap="openKb">
    <view class="kb-entry-main">
      <view class="h2" style="margin:0">📚 病虫害知识库</view>
      <view class="small muted">12 种常见病虫害 · 症状、鉴别与防治要点</view>
    </view>
    <text class="picker-arrow">›</text>
  </view>

  <view class="card">
    <view class="h2">拍照识别病虫害</view>
    <view class="photo-box" bindtap="choosePhoto">
      <image wx:if="{{preview}}" src="{{preview}}" mode="aspectFill" class="photo"></image>
      <view wx:else class="photo-empty">
        <text class="cam">📷</text>
        <text>点击拍照 / 从相册选择</text>
        <text class="small muted">选多张自动巡园（最多 9 张），上传前压缩至 1080p</text>
      </view>
    </view>

    <view class="field mt">
      <text class="label">地块</text>
      <picker mode="selector" range="{{plotNames}}" value="{{plotIndex}}" bindchange="onPlotChange">
        <view class="picker-value">
          <text>{{plotNames[plotIndex] || '请选择地块'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="label">距预计采收天数（可选，用于安全间隔期校验）</text>
      <input type="number" placeholder="如 5 表示 5 天后采收" value="{{days}}" bindinput="onDaysInput" />
    </view>

    <view wx:if="{{loading}}" class="btn block" disabled>识别中…</view>
    <view wx:else class="btn block" bindtap="choosePhoto">拍照 / 选图识别</view>
    <view wx:if="{{error}}" class="alert critical mt"><view class="al-detail">{{error}}</view></view>
  </view>

  <view class="card">
    <view class="h2">演示模式（无需图片）</view>
    <view class="field">
      <text class="label">选择病虫害类别</text>
      <picker mode="selector" range="{{pestNames}}" value="{{pestIndex}}" bindchange="onPestChange">
        <view class="picker-value">
          <text>{{pestNames[pestIndex] || '请选择'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="btn ghost block" bindtap="runDemo">生成识别结果与防治建议</view>
  </view>

  <view wx:if="{{result}}" class="card" id="resultCard">
    <view class="head">
      <text class="title">识别结果</text>
      <text class="pill {{result.riskClass}}">{{result.pest_class}}</text>
    </view>
    <view class="kv"><text class="k">置信度</text><text class="v">{{result.confidencePct}}%</text></view>
    <view class="kv"><text class="k">风险等级</text><text class="v">{{result.suggestion.risk}}（{{result.suggestion.kind}}）</text></view>
    <view wx:if="{{result.hostPartsText}}" class="kv"><text class="k">危害部位</text><text class="v">{{result.hostPartsText}}</text></view>
    <view wx:if="{{result.peakText}}" class="kv"><text class="k">高发期</text><text class="v">{{result.peakText}}</text></view>
    <view class="kv"><text class="k">识别来源</text><text class="v">{{result.sourceLabel}}</text></view>
    <view wx:if="{{result.verificationText}}" class="mt">
      <text class="pill {{result.verificationClass}}">二次确认：{{result.verificationText}}</text>
    </view>

    <view class="pre mt">{{result.suggestion.text}}</view>

    <view wx:if="{{result.confusableText}}" class="alert warning mt">
      <view class="al-title">易混淆：{{result.confusableText}}</view>
      <view class="al-detail">{{result.distinguishingText}}</view>
    </view>

    <view wx:if="{{result.nonChemical.length}}" class="alert good mt">
      <view class="al-title">非化学措施</view>
      <view class="al-detail" wx:for="{{result.nonChemical}}" wx:key="*this">· {{item}}</view>
    </view>

    <view wx:if="{{result.monitoringText}}" class="alert warning mt">
      <view class="al-title">监测要点</view>
      <view class="al-detail">{{result.monitoringText}}</view>
    </view>

    <view wx:if="{{result.biological.length}}" class="alert good mt">
      <view class="al-title">生物防治</view>
      <view class="al-detail" wx:for="{{result.biological}}" wx:key="*this">· {{item}}</view>
    </view>

    <view wx:if="{{result.pesticides.length}}" class="pills mt">
      <text wx:for="{{result.pesticides}}" wx:key="name" class="pill neutral">{{item.name}} · {{item.safe_interval_days}}天</text>
    </view>

    <view wx:for="{{result.warnings}}" wx:key="*this" class="alert serious mt">
      <view class="al-detail">{{item}}</view>
    </view>

    <view wx:if="{{result.handleTip}}" class="alert good mt">
      <view class="al-title">已写入台账</view>
      <view class="al-detail">{{result.handleTip}}</view>
    </view>

    <view wx:if="{{result.pending && result.showActions}}" class="alert good mt">
      <view class="al-title">系统建议：{{result.actionLabel}}</view>
      <view class="al-detail">{{result.actionReason}}</view>
    </view>

    <block wx:if="{{result.pending && result.showActions}}">
      <view class="small muted mt">识别后处置（形成闭环，处置记录回链本次识别）</view>
      <view wx:if="{{result.pesticides.length}}" class="{{result.pesticideBtnClass}} block mt" bindtap="handleRecognition" data-method="pesticide">按建议用药{{result.recommendedAction === 'pesticide' ? ' · 推荐' : ''}}</view>
      <view class="{{result.operationBtnClass}} block mt" bindtap="handleRecognition" data-method="operation">人工清除{{result.recommendedAction === 'operation' ? ' · 推荐' : ''}}</view>
      <view class="row mt">
        <view class="btn ghost" bindtap="handleRecognition" data-method="false_positive">误判</view>
        <view class="{{result.ignoreBtnClass}}" bindtap="handleRecognition" data-method="ignore">忽略{{result.recommendedAction === 'ignore' ? ' · 推荐' : ''}}</view>
      </view>
    </block>
    <block wx:elif="{{result.pending}}">
      <view class="row mt">
        <view class="btn ghost" bindtap="handleRecognition" data-method="false_positive">误判</view>
        <view class="btn ghost" bindtap="handleRecognition" data-method="ignore">忽略</view>
      </view>
    </block>
    <view wx:else class="mt"><text class="pill good">已处置</text></view>

    <view wx:if="{{result.kbName}}" class="btn ghost block mt" bindtap="openKbDetail" data-name="{{result.kbName}}">查看「{{result.kbName}}」知识库详情</view>
  </view>

  <view wx:if="{{patrolProgress}}" class="card muted">{{patrolProgress}}</view>

  <view wx:if="{{patrol}}" class="card">
    <view class="head">
      <text class="title">巡园报告</text>
      <text class="pill {{patrol.total ? 'serious' : 'good'}}">{{patrol.total}} 处异常</text>
    </view>
    <view class="pre">{{patrol.summary}}</view>
    <view wx:if="{{patrol.byClass.length}}" class="mt">
      <view wx:for="{{patrol.byClass}}" wx:key="name" class="list-item">
        <view class="li-main">
          <view class="li-title">{{item.name}} · {{item.count}} 处</view>
        </view>
        <text wx:if="{{item.risk}}" class="pill {{item.riskClass}}">风险 {{item.risk}}</text>
      </view>
    </view>
    <view wx:if="{{patrol.focusText}}" class="small mt">建议重点巡查：{{patrol.focusText}}</view>
    <view wx:if="{{patrol.byPlot.length}}" class="small muted mt">
      <text wx:for="{{patrol.byPlot}}" wx:key="plot_id">{{item.plot_name}} {{item.count}} 处<text wx:if="{{index < patrol.byPlot.length - 1}}"> · </text></text>
    </view>
    <view wx:for="{{patrol.advice}}" wx:key="class" class="alert warning mt">
      <view class="al-title">{{item.class}} · 监测要点</view>
      <view class="al-detail">{{item.monitoring}}</view>
    </view>
    <view wx:if="{{patrol.failureText}}" class="alert serious mt">
      <view class="al-detail">{{patrol.failureText}}，可重新拍这几张补识别</view>
    </view>
  </view>

  <view class="card" id="historyCard">
    <view class="head">
      <text class="title">识别记录</text>
      <text class="pill neutral">{{history.length}} 条</text>
    </view>
    <view wx:if="{{!history.length}}" class="empty">暂无识别记录，先拍一张或试试演示模式</view>
    <view wx:for="{{history}}" wx:key="id" class="hist-item" bindtap="openHistory" data-index="{{index}}">
      <view class="hist-main">
        <view class="hist-title">{{item.pestName}}</view>
        <view class="hist-meta">{{item.plotName}} · {{item.timeText}} · 置信度 {{item.confidencePct}}%</view>
      </view>
      <text class="pill {{item.statusClass}}">{{item.statusText}}</text>
    </view>
  </view>
</view>
