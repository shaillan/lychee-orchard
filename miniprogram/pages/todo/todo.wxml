<view class="wrap {{fontClass}}">
  <view class="hero">
    <view class="hero-title">智慧果园管家</view>
    <view class="hero-sub">东风荔枝果园 · 从田间到餐桌</view>
  </view>

  <view class="quick">
    <view class="quick-item" bindtap="scan">
      <text class="qi">⌗</text>
      <text>扫码溯源</text>
    </view>
    <view class="quick-item" bindtap="goBatches">
      <text class="qi">▣</text>
      <text>批次二维码</text>
    </view>
    <view class="quick-item" bindtap="goTrace">
      <text class="qi">⌕</text>
      <text>输入溯源码</text>
    </view>
  </view>

  <view class="card">
    <view class="kv" style="align-items:center">
      <view>
        <view class="h2" style="margin:0">大字模式</view>
        <view class="small muted">放大字号，方便田间查看</view>
      </view>
      <switch checked="{{bigFont}}" color="#1f6f4a" bindchange="onFontToggle" />
    </view>
  </view>

  <view class="card">
    <view class="h2" style="margin:0">天气地区</view>
    <view class="small muted">天气预警按此地区生成，H5 与小程序共用</view>
    <view class="kv mt"><text class="k">当前地区</text><text class="v">{{regionLabel}}</text></view>
    <view class="field mt">
      <text class="label">地区名（如 广州）</text>
      <input placeholder="输入城市名" value="{{regionName}}" bindinput="onRegionInput" />
    </view>
    <view class="btn block" bindtap="saveRegion">{{regionSaving ? '保存中…' : '保存地区'}}</view>
    <view wx:if="{{regionMsg}}" class="alert {{regionOk ? 'good' : 'critical'}} mt">
      <view class="al-detail">{{regionMsg}}</view>
    </view>
  </view>

  <view class="h2">今日待办</view>

  <view wx:if="{{loading}}" class="card muted">加载中…</view>
  <view wx:elif="{{error}}" class="card error">{{error}}</view>
  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="card empty">今日暂无待办，果园状态正常</view>
    <view wx:for="{{items}}" wx:key="title" class="alert {{item.level}}">
      <view class="al-title">{{item.title}}</view>
      <view class="al-detail">{{item.detail}}</view>
      <view wx:if="{{item.type === 'recognition'}}" class="btn ghost small mt" bindtap="goScan">去处置</view>
      <view wx:elif="{{item.type === 'weather'}}" class="btn ghost small mt" bindtap="goScan">去拍照识别</view>
      <view wx:elif="{{item.action}}" class="small muted mt">{{item.action}}</view>
    </view>
  </block>
</view>
