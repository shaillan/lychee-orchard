/* ---- 知识库头图 ---------------------------------------------------------- */
.kb-hero { padding-bottom: 30rpx; }

/* ---- 搜索与筛选 ---------------------------------------------------------- */
.kb-search { padding-bottom: 18rpx; }
.kb-search .field { margin-bottom: 14rpx; }
.kb-filters { display: flex; flex-wrap: wrap; }
.kb-filter {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 8rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid #DCE8DF;
  background: #FFFFFF;
  color: #4E6155;
  font-size: 24rpx;
}
.kb-filter.on {
  background: #166A49;
  background: var(--brand-700);
  border-color: #166A49;
  border-color: var(--brand-700);
  color: #FFFFFF;
}
.kb-filter-tap { opacity: 0.75; }

/* ---- 条目卡片 ------------------------------------------------------------ */
.kb-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(20, 60, 40, 0.05);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 61, 40, 0.07);
}
.kb-card-tap { opacity: 0.9; transform: scale(0.995); }
.kb-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  font-size: 38rpx;
}
.kb-icon-pest { background: #FCF3DF; }
.kb-icon-disease { background: #FBEDE9; }
.kb-main { flex: 1; min-width: 0; }
.kb-head { display: flex; align-items: center; }
.kb-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #15241B;
  color: var(--ink);
}
.kb-head .pill { flex: none; margin-left: 10rpx; }
.kb-latin { margin-top: 2rpx; font-size: 20rpx; color: #8A9A8F; }
.kb-symptom {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #4E6155;
  overflow-wrap: break-word;
}
.kb-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #65766B;
  color: var(--muted);
  overflow-wrap: break-word;
}
.kb-arrow {
  flex: none;
  align-self: center;
  margin-left: 10rpx;
  font-size: 34rpx;
  color: #B3C0B8;
}

.tip {
  padding: 8rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #65766B;
  color: var(--muted);
}

/* ---- 大字模式 ------------------------------------------------------------ */
.font-lg .kb-filter { font-size: 29rpx; }
.font-lg .kb-name { font-size: 35rpx; }
.font-lg .kb-latin { font-size: 25rpx; }
.font-lg .kb-symptom { font-size: 29rpx; }
.font-lg .kb-meta { font-size: 27rpx; }
.font-lg .tip { font-size: 27rpx; }
