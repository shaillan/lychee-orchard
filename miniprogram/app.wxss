page {
  background: #f4f7f4;
  color: #1d2a22;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.55;
}

.wrap {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 60, 40, 0.06);
}

.h2 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.muted { color: #7a8a80; }
.small { font-size: 24rpx; }
.mt { margin-top: 16rpx; }

.kv {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f3f0;
}
.kv:last-child { border-bottom: none; }
.k { color: #7a8a80; flex: none; margin-right: 24rpx; }
.v { color: #1d2a22; text-align: right; }

.pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
}
.pill.good { background: #e6f4ea; color: #1f7a3f; }
.pill.warning { background: #fff4e0; color: #a86400; }
.pill.serious { background: #fff0e0; color: #b35400; }
.pill.critical { background: #fdeaea; color: #c0392b; }
.pill.neutral { background: #eef2ee; color: #4a5a50; }

.alert {
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #b9c8be;
  background: #ffffff;
}
.alert.good { border-color: #2f9e5a; background: #f3fbf5; }
.alert.warning { border-color: #e0a106; background: #fffaf0; }
.alert.serious { border-color: #e07b00; background: #fff6ec; }
.alert.critical { border-color: #cf3b2e; background: #fdf3f2; }
.al-title { font-weight: 600; margin-bottom: 6rpx; }
.al-detail { color: #5a6a60; font-size: 26rpx; }

.btn {
  background: #1f6f4a;
  color: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 30rpx;
}
.btn.ghost {
  background: #ffffff;
  color: #1f6f4a;
  border: 1rpx solid #cfe3d7;
}
.btn.small { padding: 14rpx 22rpx; font-size: 26rpx; }
.btn.block { width: 100%; }
.btn-tap { opacity: 0.86; }
.btn[disabled] { opacity: 0.55; }

.field { margin-bottom: 22rpx; }
.field .label {
  display: block;
  color: #4a5a50;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}
.field input,
.field .picker-value {
  background: #f7faf8;
  border: 1rpx solid #e2eae5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 44rpx;
}
.field .picker-value { display: flex; align-items: center; justify-content: space-between; }
.picker-arrow { color: #9aa8a0; }

.row { display: flex; }
.row .btn { flex: 1; }
.row .btn + .btn { margin-left: 16rpx; }

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1f6f4a, #2f8a5c);
  border-radius: 22rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }

.quick {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 60, 40, 0.06);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #3d4d43;
}
.quick-item .qi { font-size: 40rpx; margin-bottom: 6rpx; }

.empty { text-align: center; color: #8a9890; padding: 40rpx 0; font-size: 26rpx; }
.error { color: #c0392b; }

/* ---------------------------------------------------------------------------
   适老化大字模式：根节点加 .font-lg 即整体放大。
   写成「.font-lg .xxx」比页面级单类选择器多一层，能压过各页 wxss，无需 !important。
   --------------------------------------------------------------------------- */
.font-lg { font-size: 34rpx; }
.font-lg .h2 { font-size: 36rpx; }
.font-lg .small { font-size: 29rpx; }
.font-lg .pill { font-size: 27rpx; }
.font-lg .al-title { font-size: 33rpx; }
.font-lg .al-detail { font-size: 31rpx; }
.font-lg .kv { font-size: 33rpx; }
.font-lg .btn { font-size: 36rpx; }
.font-lg .btn.small { font-size: 31rpx; padding: 18rpx 26rpx; }
.font-lg .field .label { font-size: 31rpx; }
.font-lg .field input,
.font-lg .field .picker-value { font-size: 33rpx; }
.font-lg .hero-title { font-size: 45rpx; }
.font-lg .hero-sub { font-size: 29rpx; }
.font-lg .quick-item { font-size: 29rpx; }
.font-lg .quick-item .qi { font-size: 48rpx; }
.font-lg .empty { font-size: 31rpx; }
.font-lg .b-code { font-size: 36rpx; }
.font-lg .b-meta { font-size: 29rpx; }
.font-lg .t-code { font-size: 41rpx; }
.font-lg .head .title { font-size: 36rpx; }
.font-lg .hist-title { font-size: 32rpx; }
.font-lg .hist-meta { font-size: 26rpx; }
.font-lg .seg-head { font-size: 33rpx; }
.font-lg .li-title { font-size: 32rpx; }
.font-lg .li-desc { font-size: 29rpx; }
.font-lg .pre { font-size: 31rpx; }
.font-lg .photo-empty { font-size: 30rpx; }
.font-lg .photo-empty .cam { font-size: 72rpx; }
.font-lg .z-code { font-size: 34rpx; }
.font-lg .z-name { font-size: 29rpx; }
.font-lg .z-tree { font-size: 27rpx; }
.font-lg .card-head .title { font-size: 34rpx; }
.font-lg .legend { font-size: 26rpx; }
.font-lg .bar-season { font-size: 26rpx; }

/* ---------------------------------------------------------------------------
   知识库页共享样式（pages/kb、pages/kb-detail）
   只被这两个页面使用，追加式定义，不影响既有页面的观感。
   --------------------------------------------------------------------------- */
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-kicker { display: block; font-size: 22rpx; opacity: 0.85; letter-spacing: 0.5rpx; }
.hero-chips { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.hero-chip {
  padding: 6rpx 18rpx;
  margin: 0 10rpx 8rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  line-height: 1.5;
}
.glow { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }
.glow-a { width: 280rpx; height: 280rpx; right: -80rpx; top: -120rpx; }
.glow-b { width: 180rpx; height: 180rpx; right: 60rpx; bottom: -100rpx; background: rgba(255, 255, 255, 0.05); }

.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.card-title { font-size: 28rpx; font-weight: 600; color: #1d2a22; }

.sec { display: flex; align-items: center; margin: 26rpx 4rpx 14rpx; }
.sec-bar { flex: none; width: 6rpx; height: 28rpx; border-radius: 3rpx; background: #1f6f4a; margin-right: 12rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: #1d2a22; }
.sec-count { margin-left: auto; font-size: 22rpx; color: #7a8a80; }

.hint { font-size: 23rpx; line-height: 1.6; color: #7a8a80; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; letter-spacing: 0.5rpx; }
.pdot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 8rpx; background: currentColor; }

.empty-icon { display: block; font-size: 52rpx; line-height: 1.3; margin-bottom: 8rpx; }
.empty-title { display: block; font-size: 28rpx; font-weight: 600; color: #1d2a22; }
.empty-sub { display: block; margin-top: 6rpx; font-size: 23rpx; line-height: 1.6; color: #7a8a80; }

@keyframes kb-shimmer {
  0% { opacity: 0.55; }
  50% { opacity: 1; }
  100% { opacity: 0.55; }
}
.skeleton { height: 26rpx; margin-bottom: 16rpx; border-radius: 8rpx; background: #e9efe9; animation: kb-shimmer 1.4s ease-in-out infinite; }
.skeleton.sk-block { height: 140rpx; }
.sk-line.w40 { width: 40%; }
.sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; }

.font-lg .hero-kicker { font-size: 27rpx; }
.font-lg .hero-chip { font-size: 27rpx; }
.font-lg .card-title { font-size: 33rpx; }
.font-lg .sec-title { font-size: 36rpx; }
.font-lg .sec-count { font-size: 26rpx; }
.font-lg .hint { font-size: 28rpx; }
.font-lg .empty-title { font-size: 34rpx; }
.font-lg .empty-sub { font-size: 28rpx; }
